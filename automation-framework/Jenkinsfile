pipeline {
    agent any

    environment {
        // Adds common macOS Maven installation paths to PATH
        PATH = "/opt/homebrew/bin:/usr/local/bin:${env.PATH}"
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Repository checked out automatically by Jenkins.'
            }
        }

        stage('Build & Test') {
            steps {
                dir('automation-framework') {
                    sh 'mvn clean test'
                }
            }
        }

        stage('Containerized Execution') {
            steps {
                dir('automation-framework') {
                    sh 'docker build -t automation-framework .'
                    sh 'docker run --rm automation-framework'
                }
            }
        }
    }

    post {
        always {
            dir('automation-framework') {
                junit allowEmptyResults: true, testResults: '**/target/surefire-reports/*.xml'
            }
        }
    }
}